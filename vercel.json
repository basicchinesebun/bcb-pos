{
  "framework": "nextjs",
  "installCommand": "npm install --include=optional",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/order", "permanent": false }
  ],
  "crons": [
    { "path": "/api/prune-slips", "schedule": "0 20 * * *" }
  ]
}
